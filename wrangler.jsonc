{
  "name": "balance-tg",
  "main": "./src/worker.js",
  "compatibility_date": "2026-11-18",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bitbalance-db",
      "database_id": "b2e0ad30-ed6e-4b32-88fa-99fb16d96fe4"
    }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1
    }
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  }
}